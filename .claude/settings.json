{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rake:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle list:*)",
      "Bash(bundle check:*)",
      "Bash(ruby -v)",
      "Bash(rbenv versions:*)",
      "Bash(gs --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)"
    ],
    "deny": [
      "Read(./coverage/**)",
      "Read(./pkg/**)",
      "Read(./.conductor/**)"
    ]
  }
}
